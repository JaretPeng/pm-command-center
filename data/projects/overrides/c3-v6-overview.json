  "retrospectives": [
    {
      "id": "c-ov-retro-merge-2025-09-03",
      "title": "2025-9-3 C3常规班与启航班并班问题",
      "date": "2025-09-03",
      "context": "C3 排课阶段，教务发现常规班与启航班并行开班但师资不足、难以按「分班授课」落地；教学侧已按「并班授课」口径准备师资与节奏。排课诉求与资源准备口径不一致，冲突在首课前暴露，本质是跨部门对「班型—课型—版本迭代」共识未及时刷新。",
      "rootCause": [
        "教学负责人缺席项目启动会，代会对「本轮是否仍为并班」「与 5.0 差异点」等关键结论记录不完整",
        "教研确认 C3 6.0 沿用 5.0 大纲后，教学侧默认「与 5.0 一致的并班模型」未同步到教务排产与班级形态沟通"
      ],
      "impact": "存在「按分班备货」与「按并班实际开班」错配风险，易引发首周舆情、到课与履约波动；需在版本窗口内快速统一口径并调整排班、话术与物料。",
      "actions": [
        "班型策略：自 C2 第 124 期起合并常规班与启航班类型；自 C3 第 95 期起新生班统一为启航班型，并与 C2 结业批次、续报价与开课节奏对齐（见下表 1）",
        "经营测算：关键参数与损益结论见下表 2；净收益 ¥1,241,180 以当时试算表为准，需随实际到课、退费与批次复核",
        "协同落地：教学、教务、教研对齐「班型定义—排课规则—师资与物料」一页共识，并走变更登记与演练"
      ],
      "lessons": [
        "新版本 Kickoff 要求各业务负责人实到；「版本迭代是否改变班级/并行策略」列为固定议程与纪要必填项",
        "将「并班/分班」与版本迭代的业务含义显式映射到排课与产能模型，避免隐性假设沿用上版本",
        "当测算显示「升级并收敛班型」在经营与体验指标上占优时，应作为后续产品线迭代的优先备选路径，与增长与口碑目标一并评审"
      ],
      "followUp": "纳入排班工具冲突提示与开班演练清单；关键周舆情、到课与投诉率纳入预警看板。",
      "supplementTables": [
        {
          "title": "表 1｜C2→C3 班型与衔接（由原文表格整理）",
          "columns": ["节点", "C2 口径", "C3 口径", "备注"],
          "rows": [
            [
              "第 124 期前",
              "常规班与启航班并存、可并行招生",
              "C3 按上一版节奏过渡承接",
              "教务常按「分班授课」备货；教学可能仍按「并班授课」准备，易在首周暴露口径差"
            ],
            [
              "C2 自第 124 期起",
              "常规班与启航班型合并为一条班型线",
              "—",
              "收敛师资、课表与物料口径，减少「双轨」排产"
            ],
            [
              "C3 自第 95 期起（新招）",
              "—",
              "新生班全部为启航班（6.0）",
              "与续报价、礼包、排课与班主任话术对齐；老生结转按当时批次政策执行"
            ]
